# Kamal secrets. Values come from ~/.config/eduskript/prod.env (outside git and
# Syncthing; mounted read-only at /secrets by bin/kamal). That file — plus a copy
# in Bitwarden — is the only place they exist once Koyeb is gone.
# STUDENT_PSEUDONYM_SECRET and NEXTAUTH_SECRET must stay byte-identical to the
# Koyeb values: a new pseudonym secret orphans every student's pseudonymous data.

ENV_FILE=/secrets/prod.env

POSTGRES_PASSWORD=$(grep -m1 '^POSTGRES_PASSWORD=' $ENV_FILE | cut -d= -f2-)
PGBACKREST_REPO2_S3_KEY=$(grep -m1 '^PGBACKREST_REPO2_S3_KEY=' $ENV_FILE | cut -d= -f2-)
PGBACKREST_REPO2_S3_KEY_SECRET=$(grep -m1 '^PGBACKREST_REPO2_S3_KEY_SECRET=' $ENV_FILE | cut -d= -f2-)
PGBACKREST_REPO2_CIPHER_PASS=$(grep -m1 '^PGBACKREST_REPO2_CIPHER_PASS=' $ENV_FILE | cut -d= -f2-)
CLOUDFLARE_API_TOKEN=$(grep -m1 '^CLOUDFLARE_API_TOKEN=' $ENV_FILE | cut -d= -f2-)
DATABASE_URL=postgres://eduskript:$POSTGRES_PASSWORD@eduskript-db:5432/eduskript?sslmode=disable

NEXTAUTH_SECRET=$(grep -m1 '^NEXTAUTH_SECRET=' $ENV_FILE | cut -d= -f2-)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=$(grep -m1 '^NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=' $ENV_FILE | cut -d= -f2-)
STUDENT_PSEUDONYM_SECRET=$(grep -m1 '^STUDENT_PSEUDONYM_SECRET=' $ENV_FILE | cut -d= -f2-)
