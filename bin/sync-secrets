#!/usr/bin/env bash
# Copy ~/.config/eduskript/prod.env into the Bitwarden secure note
# "eduskript prod.env" (created if missing). That file + this note are the
# only copies of the production secrets (STUDENT_PSEUDONYM_SECRET, DB password,
# pgBackRest repo2 passphrase, …) — run this after every change to prod.env.
#
# Needs the Bitwarden CLI (`bw`) logged in once (`bw login`); asks for the
# master password to unlock. The session is not stored anywhere.
set -euo pipefail
FILE="$HOME/.config/eduskript/prod.env"
NAME="eduskript prod.env"
command -v bw >/dev/null || { echo "bw (Bitwarden CLI) not installed: npm i -g @bitwarden/cli"; exit 1; }
command -v jq >/dev/null || { echo "jq not installed"; exit 1; }

export BW_SESSION="${BW_SESSION:-$(bw unlock --raw)}"
bw sync >/dev/null
id=$(bw list items --search "$NAME" | jq -r --arg n "$NAME" '[.[] | select(.name == $n)][0].id // empty')
content=$(cat "$FILE")
if [ -n "$id" ]; then
  bw get item "$id" | jq --arg c "$content" '.notes = $c' | bw encode | bw edit item "$id" >/dev/null
  echo "updated \"$NAME\" ($(wc -l < "$FILE") lines)"
else
  bw get template item | jq --arg n "$NAME" --arg c "$content" \
    '.type = 2 | .secureNote = {"type": 0} | .name = $n | .notes = $c | .login = null' \
    | bw encode | bw create item >/dev/null
  echo "created \"$NAME\" ($(wc -l < "$FILE") lines)"
fi
bw lock >/dev/null
