#!/usr/bin/env bash
# Back up the production secrets from the VPS (/etc/eduskript/{app,db,caddy,files-backup}.env,
# the only live copy) into the Bitwarden secure note "eduskript server env"
# (created if missing). Run after every secret change on the server. Restore =
# paste each "# <name>.env" section back into /etc/eduskript/<name>.env.
# The older note "eduskript prod.env" (pre-2026-10-28 local file) also holds
# non-deployed keys (e.g. healthchecks API key) and is not touched here.
#
# Needs the Bitwarden CLI (`bw`) logged in once (`bw login`); asks for the
# master password to unlock. The session is not stored anywhere.
set -euo pipefail
cd "$(dirname "$0")/.."
NAME="eduskript server env"
command -v bw >/dev/null || { echo "bw (Bitwarden CLI) not installed: npm i -g @bitwarden/cli"; exit 1; }
command -v jq >/dev/null || { echo "jq not installed"; exit 1; }
source bin/lib/prod-ssh.sh
content=$("${PROD_SSH[@]}" 'for f in app db caddy files-backup; do echo "# $f.env"; cat /etc/eduskript/$f.env; done')
lines=$(grep -c . <<<"$content")

export BW_SESSION="${BW_SESSION:-$(bw unlock --raw)}"
bw sync >/dev/null
id=$(bw list items --search "$NAME" | jq -r --arg n "$NAME" '[.[] | select(.name == $n)][0].id // empty')
if [ -n "$id" ]; then
  bw get item "$id" | jq --arg c "$content" '.notes = $c' | bw encode | bw edit item "$id" >/dev/null
  echo "updated \"$NAME\" ($lines lines)"
else
  bw get template item | jq --arg n "$NAME" --arg c "$content" \
    '.type = 2 | .secureNote = {"type": 0} | .name = $n | .notes = $c | .login = null' \
    | bw encode | bw create item >/dev/null
  echo "created \"$NAME\" ($lines lines)"
fi
bw lock >/dev/null
