#!/usr/bin/env bash
# Restart the Caddy accessory with the current config/Caddyfile and env.
# `kamal accessory reboot caddy` would try to pull the VPS-built image.
# Certificates persist in /var/lib/eduskript/caddy. ~5 s outage.
set -euo pipefail
cd "$(dirname "$0")/.."
source bin/lib/prod-ssh.sh
"${PROD_SSH[@]}" 'test -s /etc/eduskript/caddy.env && docker stop eduskript-caddy && docker rm eduskript-caddy'
bin/kamal accessory boot caddy
